<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>io.NET.ZTR_OS.Android</RootNamespace>
    <AssemblyName>MSMC.Android</AssemblyName>
    <ApplicationId>io.net.ztr_os.msmc</ApplicationId>
    <ApplicationTitle>MSMC on Android</ApplicationTitle>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>

    <!-- 双 flavor 占位：internal=捆绑 Termux+JDK（M1 起）；external=不捆绑 -->
    <AppFlavor Condition="'$(AppFlavor)' == ''">internal</AppFlavor>
    <DefineConstants Condition="'$(AppFlavor)' == 'external'">$(DefineConstants);MSMC_EXTERNAL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MSMC.Shared/MSMC.Shared.csproj" />
    <ProjectReference Include="../MSMC.Libsu/MSMC.Libsu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.*" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.*" />
    <PackageReference Include="SharpCompress" Version="0.38.*" />
  </ItemGroup>

  <!-- 内置 Termux bootstrap（CI 装配，可缺省 → 运行时下载兜底） -->
  <ItemGroup>
    <AndroidAsset Condition="Exists('Assets/termux-bootstrap.zip')" Include="Assets/termux-bootstrap.zip" />
    <!-- 内置 4×JDK（仅 internal flavor，CI 装配） -->
    <AndroidAsset Condition="Exists('Assets/jdk17.tar.gz')" Include="Assets/jdk17.tar.gz" />
    <AndroidAsset Condition="Exists('Assets/jdk21.tar.gz')" Include="Assets/jdk21.tar.gz" />
    <AndroidAsset Condition="Exists('Assets/jdk25.tar.gz')" Include="Assets/jdk25.tar.gz" />
    <AndroidAsset Condition="Exists('Assets/jdk26.tar.gz')" Include="Assets/jdk26.tar.gz" />
    <!-- 内置前端 dist（CI 装配） -->
    <AndroidAsset Condition="Exists('Assets/www.zip')" Include="Assets/www.zip" />
  </ItemGroup>
</Project>